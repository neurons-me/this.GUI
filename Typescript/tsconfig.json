{
  "compilerOptions": {
    // Target modern browsers; Vite/Rollup will transpile/bundle JS.
    "target": "ES2020",
    // Declarations build (types)
    "declaration": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "outDir": "dist",
    "declarationDir": "dist",
    // NOTE: With `emitDeclarationOnly`, tsc will NOT output JS (only .d.ts).
    // Module settings compatible with Vite + TS
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    // Quality-of-life
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "allowSyntheticDefaultImports": true,
    "isolatedModules": true,
    "forceConsistentCasingInFileNames": true,
    "lib": ["ES2020", "DOM"],
    // Path aliases used by this.gui source
    "paths": {
      "@/gui/Atoms": ["./src/gui/Atoms/atoms.ts"],
      "@/gui/Atoms/*": ["./src/gui/Atoms/*"],
      "@/gui/atoms": ["./src/gui/Atoms/atoms.ts"],
      "@/gui/atoms/*": ["./src/gui/Atoms/*"],
      "@/gui/Molecules": ["./src/gui/Molecules/molecules.ts"],
      "@/gui/Molecules/*": ["./src/gui/Molecules/*"],
      "@/gui/molecules": ["./src/gui/Molecules/molecules.ts"],
      "@/gui/molecules/*": ["./src/gui/Molecules/*"],
      "@/gui/Compounds": ["./src/gui/Compounds/compounds.ts"],
      "@/gui/Compounds/*": ["./src/gui/Compounds/*"],
      "@/gui/compounds": ["./src/gui/Compounds/compounds.ts"],
      "@/gui/compounds/*": ["./src/gui/Compounds/*"],
      "@/gui/Marketplace": ["./src/gui/Marketplace/marketplace.ts"],
      "@/gui/Marketplace/*": ["./src/gui/Marketplace/*"],
      "@/gui/marketplace": ["./src/gui/Marketplace/marketplace.ts"],
      "@/gui/marketplace/*": ["./src/gui/Marketplace/*"],
      "@/gui/Hooks": ["./src/gui-internals/Hooks/index.ts"],
      "@/gui/Hooks/*": ["./src/gui-internals/Hooks/*"],
      "@/gui/hooks": ["./src/gui-internals/Hooks/index.ts"],
      "@/gui/hooks/*": ["./src/gui-internals/Hooks/*"],
      "@/gui/Contexts": ["./src/gui-internals/Contexts/index.ts"],
      "@/gui/Contexts/*": ["./src/gui-internals/Contexts/*"],
      "@/gui/contexts": ["./src/gui-internals/Contexts/index.ts"],
      "@/gui/contexts/*": ["./src/gui-internals/Contexts/*"],
      "@/gui/Theme": ["./src/gui/Theme"],
      "@/gui/Theme/*": ["./src/gui/Theme/*"],
      "@/gui/components": ["./src/gui/Compounds/compounds.ts"],
      "@/gui/components/*": ["./src/gui/Compounds/*"],
      "@/stories": ["./src/stories"],
      "@/stories/*": ["./src/stories/*"],
      "cleaker": ["../../../../modules/cleaker/Typescript/dist-types/index.d.ts"],
      "@/*": ["./src/*"]
    },
    // IMPORTANT:
    // - Keep this as just "node" for the build.
    // - Remove "vite/client" to avoid leaking Vite-only types into published d.ts.
    "types": ["node"]
  },

  // Only compile the library surface + src for type emission.
  "include": ["index.ts", "src", "src/types/"],
  // Never emit declarations for build outputs / dependencies
  "exclude": [
    "node_modules",
    "dist",
    "demo",
    "test",
    "tests",
    "__tests__",
    "coverage",
    ".storybook",
    "../../../../z.more/neurons-me.github.io/storybook-static"
  ]
}
