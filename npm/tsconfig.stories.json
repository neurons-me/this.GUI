{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "declaration": true,
    "declarationMap": false,
    "emitDeclarationOnly": false
  },
  "include": [
    "src/stories/**/*.ts",
    "src/stories/**/*.tsx",
    "src/**/*.d.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "coverage"
  ]
}
